diff --git a/scripts/build-deb.sh b/scripts/build-deb.sh
index 531f585..71446d5 100755
--- a/scripts/build-deb.sh
+++ b/scripts/build-deb.sh
@@ -59,6 +59,30 @@ main() {
         "$CONTROL_TEMPLATE" > "$PKG_ROOT/DEBIAN/control"
     chmod 0644 "$PKG_ROOT/DEBIAN/control"
 
+    # Maintainer scripts. postinst is required for the WorkBuddy AI port: the
+    # application logs in through an external browser and returns via a deep
+    # link, so x-scheme-handler/workbuddy-ai AND x-scheme-handler/workbuddy
+    # must be registered in the desktop database or the OAuth callback never
+    # reaches the app.
+    local maintainer_script
+    for maintainer_script in postinst postrm; do
+        local template="$REPO_DIR/packaging/linux/$maintainer_script"
+        [ -f "$template" ] || continue
+        workbuddy_info "Installing maintainer script: $maintainer_script"
+        sed -e "s/__PACKAGE_NAME__/$PACKAGE_NAME/g" \
+            "$template" > "$PKG_ROOT/DEBIAN/$maintainer_script"
+        chmod 0755 "$PKG_ROOT/DEBIAN/$maintainer_script"
+    done
+
+    # XDG MIME declaration covering both URI schemes (workbuddy-ai + workbuddy).
+    local mime_template="$REPO_DIR/packaging/linux/workbuddy-ai-mime.xml"
+    if [ -f "$mime_template" ]; then
+        workbuddy_info "Installing MIME declarations for URI schemes"
+        mkdir -p "$PKG_ROOT/usr/share/mime/packages"
+        cp "$mime_template" "$PKG_ROOT/usr/share/mime/packages/$PACKAGE_NAME.xml"
+        chmod 0644 "$PKG_ROOT/usr/share/mime/packages/$PACKAGE_NAME.xml"
+    fi
+
     mkdir -p "$DIST_DIR"
     workbuddy_info "Building $output_file"
     if [ "$MAX_BUILD_THREADS" != "0" ]; then
