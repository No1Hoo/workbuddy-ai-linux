diff --git a/packaging/linux/postinst b/packaging/linux/postinst
new file mode 100644
index 0000000..66f36ef
--- /dev/null
+++ b/packaging/linux/postinst
@@ -0,0 +1,36 @@
+#!/bin/bash
+# Refresh the XDG databases so the URI-scheme registrations shipped with the
+# desktop entry actually take effect.
+#
+# WorkBuddy AI signs in through an external browser and hands control back via
+# a deep link. Two schemes matter and BOTH must resolve:
+#
+#   workbuddy-ai : product.json { urlProtocol, deepLinkSchemes } — this is the
+#                  OAuth redirect_uri base ("<scheme>://ima/auth/complete").
+#   workbuddy    : hard-coded in the app bundle for internal deep links
+#                  (workbuddy://home, workbuddy://chat/{id}, workbuddy://experts,
+#                  workbuddy://wechat/share).
+#
+# Without update-desktop-database the x-scheme-handler/* associations stay
+# unregistered and the browser drops the OAuth callback.
+set -e
+
+PACKAGE_NAME="${PACKAGE_NAME:-workbuddy-ai}"
+DESKTOP_FILE="$PACKAGE_NAME.desktop"
+
+if command -v update-desktop-database >/dev/null 2>&1; then
+    update-desktop-database -q /usr/share/applications || true
+fi
+
+if command -v update-mime-database >/dev/null 2>&1; then
+    update-mime-database /usr/share/mime || true
+fi
+
+# Belt-and-braces: make the association explicit for both schemes.
+if command -v xdg-mime >/dev/null 2>&1; then
+    for scheme in workbuddy-ai workbuddy; do
+        xdg-mime default "$DESKTOP_FILE" "x-scheme-handler/$scheme" || true
+    done
+fi
+
+exit 0
diff --git a/packaging/linux/postrm b/packaging/linux/postrm
new file mode 100644
index 0000000..3427dc5
--- /dev/null
+++ b/packaging/linux/postrm
@@ -0,0 +1,9 @@
+#!/bin/bash
+# Drop the stale workbuddy-ai:// handler association after removal.
+set -e
+
+if command -v update-desktop-database >/dev/null 2>&1; then
+    update-desktop-database -q /usr/share/applications || true
+fi
+
+exit 0
diff --git a/packaging/linux/workbuddy-ai-mime.xml b/packaging/linux/workbuddy-ai-mime.xml
new file mode 100644
index 0000000..a88452c
--- /dev/null
+++ b/packaging/linux/workbuddy-ai-mime.xml
@@ -0,0 +1,25 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!--
+  XDG MIME declarations for the WorkBuddy AI URI schemes.
+
+  Two schemes are registered on purpose:
+    * workbuddy-ai : declared by product.json (urlProtocol / deepLinkSchemes).
+                     Used as the OAuth redirect_uri base
+                     ("<scheme>://ima/auth/complete") when signing in with
+                     Google / GitHub from the international build.
+    * workbuddy    : the scheme hard-coded throughout the application bundle
+                     for in-app deep links (workbuddy://home,
+                     workbuddy://chat/{sessionId}, workbuddy://experts?expertId=,
+                     workbuddy://wechat/share?...).
+
+  Registering only one of them silently breaks part of the deep-link surface,
+  so both are shipped.
+-->
+<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
+  <mime-type type="x-scheme-handler/workbuddy-ai">
+    <comment>WorkBuddy AI protocol (OAuth callback)</comment>
+  </mime-type>
+  <mime-type type="x-scheme-handler/workbuddy">
+    <comment>WorkBuddy deep link protocol</comment>
+  </mime-type>
+</mime-info>
